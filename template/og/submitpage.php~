function getSID(){
  var ofrm1 = document.getElementById("testRun").document;  
  var ret="0";
  if (ofrm1==undefined){
    ofrm1 = document.getElementById("testRun").contentWindow.document;
    var ff = ofrm1;
    ret=ff.innerHTML;
  }else{
    var ie = document.frames["frame1"].document;
    ret=ie.innerText;
  }
  return ret+"";
}

